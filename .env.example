# Copy to .env for running against the compose database from a local venv.
# The containers do not read this file - they get their env from docker-compose.yml.
#
# Note the port: the compose Postgres is published on 5433 because a native
# Postgres already owns 5432 on this machine. Inside the compose network the
# containers still use db:5432.

POSTGRES_DB=cascade
POSTGRES_USER=cascade
POSTGRES_PASSWORD=cascade
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-real-secret

# Engine tuning
TASK_LEASE_SECONDS=30
TASK_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=1.0
